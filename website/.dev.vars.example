# Copy to .dev.vars for local `wrangler pages dev`. Do not commit real keys.
# In production these are set as Pages secrets, not from this file.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. Requires a domain verified in Resend.
RESEND_FROM=Moa <hello@yourdomain.com>

# Optional reply-to address
RESEND_REPLY_TO=hello@yourdomain.com

# Pet studio proxy. The browser calls /api/pets/*; the Pages function forwards
# to the token-guarded gateway endpoints.
MOA_GATEWAY_URL=http://127.0.0.1:8787
MOA_GATEWAY_TOKEN=change-me
