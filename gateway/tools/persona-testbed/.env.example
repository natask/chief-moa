# Copy to .env in this directory, paste keys, then run:
#   node --env-file=.env run.mjs
# Gemini needs no key here — it uses gcloud ADC, same as the gateway.

# platform.openai.com -> API keys (billing is separate from ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# console.x.ai -> API Keys (needs a card on file; new accounts get promo credits)
XAI_API_KEY=
GROK_MODEL=grok-4

# console.anthropic.com -> API Keys (billing is separate from the Claude subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
