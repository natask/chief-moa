# Copy this to /opt/chief-moa/.env on the VPS and fill real secrets there.
# Do not commit the filled file.

MOA_MODE=self-host
TRUST_PROXY=1
PUBLIC_GATEWAY_URL=https://api.agee.app
GATEWAY_HOST_PORT=8787
GATEWAY_PORT=8787

# Required in remote modes until better-auth/device registration lands.
MOA_GATEWAY_TOKEN=replace-with-long-random-token

# Compose Postgres credentials. DATABASE_URL is assembled by docker-compose.yml.
POSTGRES_DB=moa_gateway
POSTGRES_USER=moa
POSTGRES_PASSWORD=replace-with-long-random-password

# Gateway model provider. Android/browser never store these.
MODEL_PROVIDER=vertex
MODEL_ID=gemini-3.5-flash
VERTEX_API_VERSION=v1beta1
VERTEX_PROJECT=replace-with-gcp-project
VERTEX_LOCATION=global
GOOGLE_CLOUD_PROJECT=replace-with-gcp-project
GOOGLE_CLOUD_LOCATION=global
# Mount or copy credentials on the VPS if using ADC/service-account auth.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-application-credentials.json

# Realtime voice. Use loopback for first transport smoke, then switch to
# vertex-live or gemini-live after /health and WebSocket transport pass.
VOICE_PROVIDER=loopback
VOICE_STT_PROVIDER=loopback
VOICE_LLM_PROVIDER=loopback
VOICE_TTS_PROVIDER=loopback
VOICE_PROVIDER_TIMEOUT_MS=60000

# Keep harness execution off the VPS until worker-pull is implemented.
DEFAULT_AGENT_HARNESS=echo
ALLOW_AGENT_WITHOUT_TOKEN=0
