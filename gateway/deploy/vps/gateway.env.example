# Compose env file for the VPS gateway stack. Copy to /opt/chief-moa/gateway.env
# on the VPS and fill in. Never commit a filled copy.
#
# Launch (repo root on the VPS):
#   docker compose -f docker-compose.yml -f docker-compose.vps.yml \
#     --env-file /opt/chief-moa/gateway.env up -d --build
#
# One image, env-driven modes. `self-host` and `hosted` run the same code;
# hosted adds per-user accounts and backup expectations as they land.
MOA_MODE=self-host

# Long random bearer token. Android and the browser extension use this token.
# Generate with: openssl rand -hex 32
MOA_GATEWAY_TOKEN=

# Promotion roles must use three additional, distinct random tokens. They let
# the VPS preview worker review, preview, and apply without reusing the broad
# client token. Generate each with: openssl rand -hex 32
MOA_DEPLOY_REVIEWER_TOKEN=
MOA_PREVIEW_DEPLOYER_TOKEN=
MOA_PRODUCTION_PROMOTER_TOKEN=

# Password for the compose Postgres service. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# TLS (docker-compose.vps.yml overlay). The DNS record for MOA_DOMAIN must
# point at this VPS before first launch so Let's Encrypt issuance succeeds.
MOA_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Optional explicit public origin used for OTA download URLs and voice tickets.
# The bootstrap script sets this to https://$MOA_DOMAIN on first run.
PUBLIC_GATEWAY_URL=https://api.example.com

# Where the gateway's direct (non-TLS) port publishes on the VPS host.
# Keep loopback on a public VPS; Caddy reaches the gateway over the compose
# network. 0.0.0.0 is only for trusted private networks without the overlay.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787

# Optional external Postgres (managed DB). When set, the compose Postgres
# service is ignored by the gateway.
# DATABASE_URL=

# Model provider (BYOK). Direct OpenAI-compatible default; see
# gateway/.env.example for the Vertex variant.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-4o-mini
MODEL_API_KEY=

# Streaming voice. Keep loopback until the HTTP path works end to end, then
# switch to gemini-live or chirp per gateway/.env.example.
VOICE_PROVIDER=loopback
VOICE_STT_PROVIDER=loopback
VOICE_LLM_PROVIDER=loopback
VOICE_TTS_PROVIDER=loopback
# GEMINI_API_KEY=

# Agent harnesses stay on the user's execution machine (worker pull).
# `echo` is the deterministic no-credential harness for the VPS itself.
DEFAULT_AGENT_HARNESS=echo
VOICE_MULTI_AGENT_HARNESSES=echo

# Blob storage for user media bytes (voice-turn PCM, audio/video notes).
# Default local keeps bytes in the data volume. gcs spools locally and
# write-behind-uploads each blob to the bucket; credentials come from the
# same Google chain the voice providers use (GOOGLE_APPLICATION_CREDENTIALS
# bind mount below, or GCP_SERVICE_ACCOUNT_KEY inline JSON).
# BLOB_STORE=gcs
# GCS_BUCKET=chief-moa-blobs-prod
# GCS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/opt/chief-moa/secrets/google-adc.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/moa/google-adc.json
