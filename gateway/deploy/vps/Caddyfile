# TLS termination for the VPS gateway. Caddy fetches and renews a Let's
# Encrypt certificate for MOA_DOMAIN and proxies HTTP and WebSocket traffic
# (including /v1/voice/sessions) to the gateway service on the compose network.

{
	email {$ACME_EMAIL}
}

{$MOA_DOMAIN} {
	# Ketera mezmur service (separate compose project on the shared
	# network); handle_path strips the /ketera prefix.
	handle_path /ketera/* {
		reverse_proxy ketera:8790
	}

	handle {
		reverse_proxy gateway:8787
	}
}
