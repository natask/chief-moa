# TLS termination for the VPS gateway. Caddy fetches and renews a Let's
# Encrypt certificate for MOA_DOMAIN and proxies HTTP and WebSocket traffic
# (including /v1/voice/sessions) to the gateway service on the compose network.

{
	email {$ACME_EMAIL}
}

{$MOA_DOMAIN} {
	reverse_proxy gateway:8787
}

# Ketera mezmur — a separate product with its own endpoint. Served directly
# by this Caddy (no Cloudflare Worker in front), so video uploads have no
# request-body cap. sslip.io resolves the hostname to the droplet IP, so
# Let's Encrypt issues a cert with no DNS token needed. Swap this hostname
# for a proxied A record (e.g. ketera.agee.app -> 143.198.226.83, DNS-only)
# once a Cloudflare Zone:DNS:Edit token exists; the origin needs no change.
ketera.143.198.226.83.sslip.io {
	reverse_proxy ketera:8790
}
