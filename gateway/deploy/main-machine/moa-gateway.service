[Unit]
Description=Moa Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reclaim
Group=reclaim
WorkingDirectory=/home/reclaim-ethiopia/moa-assistant/gateway
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/reclaim-ethiopia/.local/bin:/home/reclaim-ethiopia/.npm-global/bin
ExecStart=/usr/bin/env node --env-file-if-exists=.env server.js
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/reclaim-ethiopia/moa-assistant/gateway /home/reclaim-ethiopia/moa-assistant-data/moa_gateway

[Install]
WantedBy=multi-user.target
