# Main-machine runtime env for /home/reclaim/moa-assistant/gateway.
# Copy to .env on 10.147.17.10 and fill in secrets there.

HOST=0.0.0.0
PORT=8788
DATA_DIR=/home/reclaim-ethiopia/moa-assistant-data/moa_gateway
ANDROID_OTA_DIR=/home/reclaim-ethiopia/moa-assistant-data/moa_gateway/android-ota

# Required for Android and protected endpoints. Generate on the server:
# openssl rand -hex 32
MOA_GATEWAY_TOKEN=replace-with-long-random-token

# First milestone: prove phone -> gateway -> phone audio transport.
VOICE_PROVIDER=loopback

# Later milestone: real realtime voice. Leave blank during loopback testing.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
VOICE_PROVIDER_TIMEOUT_MS=60000

# Existing chat/agent path. Keep these configured when the gateway should also
# route text chat or local agent harness requests.
MODEL_PROVIDER=vertex
MODEL_ID=gemini-2.5-flash
MODEL_MAX_OUTPUT_TOKENS=512
VERTEX_PROJECT=deploy-465618
VERTEX_LOCATION=global
GOOGLE_CLOUD_PROJECT=deploy-465618
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/home/reclaim-ethiopia/.config/gcloud/application_default_credentials.json
GCLOUD_BIN=gcloud

SYSTEM_PROMPT=You are Moa, a concise voice-first Android assistant. Answer directly, keep replies short enough to speak aloud, and ask one clear follow-up only when needed.

DEFAULT_AGENT_HARNESS=codex
VOICE_MULTI_AGENT_HARNESSES=codex,claude
HARNESS_WORKDIR=/home/reclaim-ethiopia/moa-assistant
AGENT_RUN_TIMEOUT_MS=600000
MAX_AGENT_PROMPT_BYTES=65536
HARNESS_STATUS_TIMEOUT_MS=1000
PROBE_GEMINI_VERSION=0
ALLOW_AGENT_WITHOUT_TOKEN=0

GEMINI_BIN=gemini
GEMINI_APPROVAL_MODE=yolo

CODEX_BIN=codex
CODEX_SANDBOX=danger-full-access
CODEX_BYPASS_APPROVALS=0

CLAUDE_BIN=claude
CLAUDE_AGENT_MODEL=sonnet
CLAUDE_PERMISSION_MODE=plan
CLAUDE_DANGEROUS_SKIP_PERMISSIONS=0
