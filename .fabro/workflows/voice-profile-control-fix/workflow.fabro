digraph VoiceProfileControlFix {
    graph [goal="Live voice profile-control requests do not end in a provider refusal"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    plan [
        label="Plan",
        prompt="Read the OpenSpec and intent artifacts. Produce a concise plan and name the files you will change."
    ]

    implement [
        label="Implement",
        prompt="Patch gateway Live voice profile-control classification, provider instructions, and refusal correction. Preserve existing profile store semantics."
    ]

    verify [
        label="Verify",
        shape=parallelogram,
        script="cd gateway && npm run check 2>&1",
        goal_gate=true
    ]

    approve [shape=hexagon, label="Approve Result"]

    start -> plan -> implement -> verify -> approve
    approve -> exit      [label="[A] Accept"]
    approve -> implement [label="[R] Revise"]
}
