{
  "name": "moa-livekit-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Flag-gated LiveKit agents-js worker for the Moa voice-transport spike (Option A). Joins gateway-minted rooms and drives Chirp STT -> gateway reasoning -> gateway TTS.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js start",
    "dev": "node dist/main.js dev",
    "test": "node --test dist/**/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**/*.js' --test-coverage-exclude='dist/**/*.test.js' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 dist/**/*.test.js"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.0",
    "@livekit/agents-plugin-silero": "^1.4.0",
    "@livekit/rtc-node": "^0.13.0",
    "livekit-server-sdk": "^2.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
