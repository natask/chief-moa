<?xml version="1.0" encoding="utf-8"?>
<!-- MOA glyph: the moa silhouette only, transparent background. Drawn by OrbView
     on top of the listening orb so the live orb carries the moa identity. Same
     bird shape as ic_moa_orb (tiny head + short beak, long high neck, egg body,
     two legs), no badge/ring. Dark fill so it reads on the teal ball. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- legs -->
    <path
        android:strokeColor="#06110D"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M49,78 L45.5,91" />
    <path
        android:strokeColor="#06110D"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M63,78 L66.5,91" />
    <!-- neck -->
    <path
        android:strokeColor="#06110D"
        android:strokeWidth="9.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M49,62 C41,50 40,34 46,25" />
    <!-- egg body -->
    <path
        android:fillColor="#06110D"
        android:pathData="M57,42a20,23 0,1 0,0.1 0z" />
    <!-- tiny head -->
    <path
        android:fillColor="#06110D"
        android:pathData="M45,16.5a6.5,6.5 0,1 0,0.1 0z" />
    <!-- short beak -->
    <path
        android:fillColor="#06110D"
        android:pathData="M39.5,21 L31,23 L39.5,26.5 Z" />
    <!-- gold eye -->
    <path
        android:fillColor="#F4D35E"
        android:pathData="M44,20a2,2 0,1 0,0.1 0z" />
</vector>
