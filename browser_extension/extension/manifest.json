{
  "manifest_version": 3,
  "name": "Ag",
  "version": "0.1.111",
  "description": "Ag is your personal AI companion in the browser. Cmd+, to type, Cmd+. to talk.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "alarms",
    "offscreen",
    "sidePanel",
    "desktopCapture",
    "userScripts",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*",
    "wss://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://10.147.17.10/*",
    "http://10.147.17.6/*",
    "wss://api.agee.app/*",
    "ws://localhost/*",
    "ws://127.0.0.1/*",
    "ws://10.147.17.10/*",
    "ws://10.147.17.6/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ui-spec-runtime.js",
        "steering-ui.js",
        "launcher-removal-runtime.js",
        "browser-command-transcript-runtime.js",
        "document-context.js",
        "ribbon-window.js",
        "ribbon-layout.js",
        "ribbon-runtime.js",
        "capture-copy-disposition.js",
        "quiet-companion-controls.js",
        "assistant-audio-replay.js",
        "content.js"
      ],
      "css": [
        "overlay.css",
        "ribbons.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tweaks.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-agee-panel": {
      "suggested_key": {
        "mac": "Command+Shift+8",
        "default": "Ctrl+Shift+8"
      },
      "description": "Open the Ag panel (works on every page, including chrome:// pages)"
    },
    "toggle-agee": {
      "suggested_key": {
        "mac": "Command+Comma",
        "default": "Ctrl+Comma"
      },
      "description": "Open Ag command mode"
    },
    "toggle-agee-voice": {
      "suggested_key": {
        "mac": "Command+Period",
        "default": "Ctrl+Period"
      },
      "description": "Start or send Ag voice"
    },
    "open-agee-global": {
      "suggested_key": {
        "mac": "Command+Shift+9",
        "default": "Ctrl+Shift+9"
      },
      "description": "Start or finish Ag dictation from any app while Chrome is running",
      "global": true
    }
  },
  "action": {
    "default_title": "Ag — open panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "moa-mark.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
