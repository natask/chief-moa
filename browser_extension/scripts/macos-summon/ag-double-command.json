{
  "title": "Ag native Mac companion summon",
  "rules": [
    {
      "description": "Double-tap Left Command to open the native Ag companion",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "conditions": [
            { "type": "variable_if", "name": "ag_left_command_tap", "value": 1 }
          ],
          "to": [
            { "set_variable": { "name": "ag_left_command_tap", "value": 0 } },
            { "shell_command": "open -a 'Ag'" }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            { "set_variable": { "name": "ag_left_command_tap", "value": 1 } },
            { "key_code": "left_command" }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              { "set_variable": { "name": "ag_left_command_tap", "value": 0 } }
            ],
            "to_if_canceled": [
              { "set_variable": { "name": "ag_left_command_tap", "value": 0 } }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 300
          }
        }
      ]
    }
  ]
}
